 src/microcode/configure.ac           |   6 +
 src/microcode/makegen/Makefile.in.in | 278 -----------------------------------
 src/microcode/makegen/makegen.scm    | 123 ++++------------
 src/microcode/makegen/sources.am     |  20 +++
 5 files changed, 89 insertions(+), 383 deletions(-)
 delete mode 100644 src/microcode/makegen/Makefile.in.in
 create mode 100644 src/microcode/makegen/sources.am

