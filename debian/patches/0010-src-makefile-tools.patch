From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Sat, 12 Sep 2026 23:33:58 +0100
Subject: src makefile tools

Of Makefile.tools.in's 27 substitutions only three were live:
MIT_SCHEME_EXE, HOST_COMPILER_HEAP and mit_scheme_native_code.  The rest
was a boilerplate block of directory and install variables nothing
referenced, and srcdir, which the file sets to "." itself.  Pass the
three in from the makefile that invokes it and no .in is needed.

It stays a separate makefile: it defines the same seventeen syntax-* and
compile-* targets as Makefile.am, for the host toolchain rather than the
target, and "make -f" is what keeps the two apart.
---
 src/Makefile.am                           | 14 +++++++--
 src/{Makefile.tools.in => Makefile.tools} | 51 ++++++-------------------------
 src/configure.ac                          |  1 -
 3 files changed, 21 insertions(+), 45 deletions(-)
 rename src/{Makefile.tools.in => Makefile.tools} (90%)

diff --git a/src/Makefile.am b/src/Makefile.am
index 87523de..81baa0e 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -39,6 +39,16 @@ BASICS_SUBDIRS = microcode runtime $(LIARC_BUNDLES)
 OPTION_SUBDIRS = @OPTION_SUBDIRS@
 
 MIT_SCHEME_EXE = @MIT_SCHEME_EXE@
+HOST_COMPILER_HEAP = @HOST_COMPILER_HEAP@
+MIT_SCHEME_NATIVE_CODE = @mit_scheme_native_code@
+
+## Makefile.tools builds the cross-compilation toolchain.  It is a separate
+## makefile because it defines the same syntax-* and compile-* targets as
+## this one, for the host rather than the target; these are the only values
+## it needs from configure, so it is a plain file rather than a .in.
+TOOLS_VARS = MIT_SCHEME_EXE='$(MIT_SCHEME_EXE)' \
+	HOST_COMPILER_HEAP='$(HOST_COMPILER_HEAP)' \
+	MIT_SCHEME_NATIVE_CODE='$(MIT_SCHEME_NATIVE_CODE)'
 AUXDIR_NAME = @AUXDIR_NAME@
 AUXDIR = @AUXDIR@
 
@@ -114,12 +124,12 @@ stamp_toolchain: runtime/host-adapter.scm
 
 .PHONY: toolchain
 toolchain:
-	+$(MAKE) -f Makefile.tools
+	+$(MAKE) -f Makefile.tools $(TOOLS_VARS)
 	echo done > stamp_toolchain
 
 .PHONY: toolclean
 toolclean:
-	+$(MAKE) -f Makefile.tools clean
+	+$(MAKE) -f Makefile.tools $(TOOLS_VARS) clean
 	-rm -f stamp_toolchain
 
 # Plugins all depend on $(PLUGINS_TOOLCHAIN) to make sure that they can
