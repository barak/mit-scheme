#!/bin/sh
# postinst script for mit-scheme-svm
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see /usr/share/doc/packaging-manual/
#
# quoting from the policy:
#     Any necessary prompting should almost always be confined to the
#     post-installation script, and should be protected with a conditional
#     so that unnecessary prompting doesn't happen if a package's
#     installation fails and the `postinst' is called with `abort-upgrade',
#     `abort-remove' or `abort-deconfigure'.

case "${1}" in
(configure)
    # The SVM back end is named by word size and byte order; ask dpkg rather
    # than keeping a table of every architecture here.
    BITS=$(dpkg-architecture -a"${DPKG_MAINTSCRIPT_ARCH}" -qDEB_HOST_ARCH_BITS 2>/dev/null)
    ENDIAN=$(dpkg-architecture -a"${DPKG_MAINTSCRIPT_ARCH}" -qDEB_HOST_ARCH_ENDIAN 2>/dev/null)
    case ${ENDIAN} in
	big) ENDIAN=be ;;
	*)   ENDIAN=le ;;
    esac
    BIN_ARCH=svm1-${BITS}${ENDIAN}
    # Up to 12.1-5 the scheme alternative pointed at /usr/bin/mit-scheme,
    # which is itself an alternative.  Two flavours cannot share that, since
    # whichever was removed first would withdraw the entry from under the
    # other, so each flavour now points scheme straight at its own
    # interpreter.  Withdrawing the old registration is a no-op if it was
    # never made.
    update-alternatives --remove scheme /usr/bin/mit-scheme
    update-alternatives \
	--install /usr/bin/mit-scheme mit-scheme /usr/bin/mit-scheme-${BIN_ARCH} 10 \
	--slave /usr/share/man/man1/mit-scheme.1.gz mit-scheme.1.gz \
	    /usr/share/man/man1/mit-scheme-${BIN_ARCH}.1.gz
    update-alternatives \
	--install /usr/bin/scheme scheme /usr/bin/mit-scheme-${BIN_ARCH} 10 \
	--slave /usr/share/man/man1/scheme.1.gz scheme.1.gz \
	    /usr/share/man/man1/mit-scheme-${BIN_ARCH}.1.gz
    ;;
(abort-upgrade|abort-remove|abort-deconfigure)
    ;;
(*)
    echo "mit-scheme-svm postinst called with unknown argument \"${1}\"" >&2
    exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
